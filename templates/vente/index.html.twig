{% extends 'base.html.twig' %}

{% block title %}Journal des Ventes - Trésorerie{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}
<div class="min-vh-100 py-4 px-3 px-md-5" style="background-color: #F8FAFC;">
    <div class="container-fluid">

        {# En-tête de page stylisé #}
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border-left: 6px solid #D4AF37 !important;">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div class="mb-3 mb-md-0">
                    <h2 class="fw-bold text-white mb-1 d-flex align-items-center">
                        <span class="badge rounded-circle p-2 me-3" style="background-color: rgba(212, 175, 55, 0.15); color: #D4AF37;">
                            <i class="fas fa-file-invoice-dollar fa-sm"></i>
                        </span>
                        Journal des Ventes
                    </h2>
                    <p class="text-light text-opacity-75 small mb-0 ms-md-5">Suivi en temps réel des facturations, taxes et règlements clients.</p>
                </div>
                <div>
                    <a href="{{ path('app_vente_new') }}" class="btn fw-bold px-4 py-2 shadow-sm" style="background-color: #D4AF37; color: #0F172A; border-radius: 8px;">
                        <i class="fas fa-plus-circle me-2"></i>Nouvelle Vente
                    </a>
                </div>
            </div>
        </div>

        {# Carte principale avec ombre marquée #}
        <div class="card shadow border-0" style="border-radius: 14px; background-color: #FFFFFF;">
            
            {# Barre supérieure de la carte #}
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                <span class="fw-bold text-uppercase small" style="color: #0F172A; letter-spacing: 0.5px;">
                    <i class="fas fa-list me-2" style="color: #D4AF37;"></i>Historique des transactions
                </span>
                <span class="badge bg-light text-dark border font-monospace">
                    Total : {{ ventes|length }} vente(s)
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #0F172A; color: #FFFFFF;">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase fs-7" style="color: #D4AF37; font-size: 0.75rem;">N° Facture</th>
                                <th class="py-3 text-uppercase fs-7" style="font-size: 0.75rem;">Date</th>
                                <th class="py-3 text-uppercase fs-7 text-end" style="font-size: 0.75rem;">Montant</th>
                                <th class="py-3 text-uppercase fs-7 text-end" style="font-size: 0.75rem;">Quantite</th>
                                {# <th class="py-3 text-uppercase fs-7 text-end" style="font-size: 0.75rem;">TTC</th> #}
                                <th class="py-3 text-uppercase fs-7 text-center" style="font-size: 0.75rem;">Remise</th>
                                <th class="py-3 text-uppercase fs-7 text-center" style="font-size: 0.75rem;">Statut</th>
                                <th class="py-3 text-uppercase fs-7 text-center pe-4" style="font-size: 0.75rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                        {% for vente in ventes %}
                            <tr style="border-bottom: 1px solid #E2E8F0;">
                                <td class="ps-4 py-3 fw-bold" style="color: #0F172A;">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle p-2 me-2 d-none d-sm-inline-block" style="background-color: #F1F5F9; color: #0F172A;">
                                            <i class="fas fa-receipt fa-xs"></i>
                                        </div>
                                        {{ vente.numeroFacture }}
                                    </div>
                                </td>
                                <td class="py-3 text-secondary small">
                                    <i class="far fa-calendar-alt me-1 text-muted"></i>
                                    {{ vente.createtAt ? vente.createtAt|date('d/m/Y') : '-' }}
                                </td>
                                <td class="py-3 text-end font-monospace fw-semibold text-dark">
                                    {{ vente.montantTotalHt ? vente.montantTotalHt|number_format(0, ',', ' ') ~ ' FCFA' : '-' }}
                                </td>
                                <td class="py-3 text-end font-monospace text-muted small">
                                    {% set quantite = 0 %}
                                    {% for item in vente.ligneVentes %}
                                        {% set quantite = quantite+1 %}
                                    {% endfor %}
                                    {{quantite }}
                                </td>
                                {# <td class="py-3 text-end font-monospace fw-bold" style="color: #0F172A; background-color: #F8FAFC;">
                                    {{ vente.montantTotalTtc ? vente.montantTotalTtc|number_format(0, ',', ' ') ~ ' FCFA' : (vente.montantTotalHt ? vente.montantTotalHt|number_format(0, ',', ' ') ~ ' FCFA' : '-') }}
                                </td> #}
                                <td class="py-3 text-center">
                                    {% if vente.remise and vente.remise > 0 %}
                                        <span class="badge rounded-pill bg-warning text-dark bg-opacity-20 border border-warning px-2">
                                            -{{ vente.remise }}%
                                        </span>
                                    {% else %}
                                        <span class="text-muted small">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 text-center">
                                    {% if vente.statuspaiement == 'PAYE' or vente.statuspaiement == 'PAYÉ' %}
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>Payé
                                        </span>
                                    {% elseif vente.statuspaiement == 'PARTIEL' %}
                                        <span class="badge bg-warning bg-opacity-15 text-warning-emphasis border border-warning rounded-pill px-3 py-2">
                                            <i class="fas fa-hourglass-half me-1"></i>Partiel
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2">
                                            <i class="fas fa-times-circle me-1"></i>Non Payé
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="py-3 text-center pe-4">
                                    <div class="btn-group shadow-sm" role="group" style="border-radius: 6px; overflow: hidden;">
                                        <a href="{{ path('app_vente_show', {'id': vente.id}) }}" class="btn btn-sm btn-light border-end" title="Voir les détails">
                                            <i class="fas fa-eye text-primary"></i> Details
                                        </a>
                                        <a href="{{ path('app_vente_edit', {'id': vente.id}) }}" class="btn btn-sm btn-light" title="Modifier">
                                            <i class="fas fa-edit text-warning"></i>Edite
                                        </a>
                                        <a href="{{ path('app_vente_benefice', {'id': vente.id}) }}" class="btn btn-sm btn-light" title="Voir les bénéfices">
                                            <i class="fas fa-chart-line text-success"></i> Bénéfices
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-5" style="background-color: #F8FAFC;">
                                    <div class="py-4">
                                        <div class="rounded-circle d-inline-flex p-4 mb-3" style="background-color: #F1F5F9;">
                                            <i class="fas fa-folder-open fa-3x" style="color: #D4AF37;"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">Aucune vente enregistrée</h5>
                                        <p class="text-muted small mb-3">Commencez par créer une nouvelle facture de vente.</p>
                                        <a href="{{ path('app_vente_new') }}" class="btn btn-sm text-white fw-bold" style="background-color: #0F172A;">
                                            <i class="fas fa-plus me-1"></i> Créer une vente
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}