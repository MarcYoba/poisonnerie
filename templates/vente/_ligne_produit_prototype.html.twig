<tr class="ligne-produit-item">
    <td>
        {{ form_widget(form.produit, {'attr': {'class': 'form-select form-select-sm'}}) }}
        {{ form_errors(form.produit) }}
    </td>
    <td>
        <div class="input-group input-group-sm">
            {{ form_widget(form.quantitePoids, {'attr': {'class': 'form-control text-end fw-bold input-poids', 'placeholder': '0.000', 'step': '0.001'}}) }}
            <span class="input-group-text">Kg</span>
        </div>
        {{ form_errors(form.quantitePoids) }}
    </td>
    <td>
        {{ form_widget(form.prixUnitaire, {'attr': {'class': 'form-control form-control-sm text-end input-prix', 'placeholder': '0.00'}}) }}
        {{ form_errors(form.prixUnitaire) }}
    </td>
    <td class="text-end fw-bold text-secondary total-ligne">
        0 FCFA
    </td>
    <td class="text-center">
        <button type="button" class="btn btn-sm btn-outline-danger btn-supprimer-ligne" title="Supprimer la ligne">
            <i class="fas fa-trash-alt"></i>
        </button>
    </td>
</tr>