<form method="post" action="{{ path('app_salary_delete', {'id': salary.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette fiche de salaire ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ salary.id) }}">
    <button class="btn btn-outline-danger">
        <i class="fas fa-trash-alt me-1"></i> Supprimer
    </button>
</form>
