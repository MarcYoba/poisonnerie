{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

    {# Erreurs globales du formulaire #}
    {% if form_errors(form) %}
        <div class="alert alert-danger border-0 shadow-sm mb-4 rounded-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-lg me-3"></i>
                <div>{{ form_errors(form) }}</div>
            </div>
        </div>
    {% endif %}

    <div class="row g-3">
        {# Type de dépense #}
        {% if form.typedepense is defined %}
            <div class="col-md-6 mb-3">
                <label for="{{ form.typedepense.vars.id }}" class="form-label fw-semibold text-dark">
                    <i class="fas fa-tags me-1" style="color: #D4AF37;"></i>Type de dépense
                </label>
                {{ form_widget(form.typedepense, {'attr': {'class': 'form-select border-1 shadow-sm'}}) }}
                <div class="text-danger small mt-1">{{ form_errors(form.typedepense) }}</div>
            </div>
        {% endif %}

        {# Montant #}
        {% if form.montant is defined %}
            <div class="col-md-6 mb-3">
                <label for="{{ form.montant.vars.id }}" class="form-label fw-semibold text-dark">
                    <i class="fas fa-coins me-1" style="color: #D4AF37;"></i>Montant
                </label>
                {{ form_widget(form.montant, {'attr': {'class': 'form-control border-1 shadow-sm', 'placeholder': 'Ex: 15000'}}) }}
                <div class="text-danger small mt-1">{{ form_errors(form.montant) }}</div>
            </div>
        {% endif %}

        {# Description / Motif #}
        {% if form.description is defined %}
            <div class="col-md-12 mb-3">
                <label for="{{ form.description.vars.id }}" class="form-label fw-semibold text-dark">
                    <i class="fas fa-align-left me-1" style="color: #D4AF37;"></i>Description / Motif
                </label>
                {{ form_widget(form.description, {'attr': {'class': 'form-control border-1 shadow-sm', 'rows': '3', 'placeholder': 'Détails ou motif de la dépense...'}}) }}
                <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
            </div>
        {% endif %}

        {# Date de la dépense (createtAt / createdAt) #}
        {% if form.createtAt is defined %}
            <div class="col-md-12 mb-3">
                <label for="{{ form.createtAt.vars.id }}" class="form-label fw-semibold text-dark">
                    <i class="far fa-calendar-alt me-1" style="color: #D4AF37;"></i>Date de création
                </label>
                {{ form_widget(form.createtAt, {'attr': {'class': 'form-control border-1 shadow-sm'}}) }}
                <div class="text-danger small mt-1">{{ form_errors(form.createtAt) }}</div>
            </div>
        {% elseif form.createdAt is defined %}
            <div class="col-md-12 mb-3">
                <label for="{{ form.createdAt.vars.id }}" class="form-label fw-semibold text-dark">
                    <i class="far fa-calendar-alt me-1" style="color: #D4AF37;"></i>Date de création
                </label>
                {{ form_widget(form.createdAt, {'attr': {'class': 'form-control border-1 shadow-sm'}}) }}
                <div class="text-danger small mt-1">{{ form_errors(form.createdAt) }}</div>
            </div>
        {% endif %}

        {# Rendu sécurisé des champs masqués (CSRF _token, etc.) #}
        {{ form_rest(form) }}
    </div>

    {# Bouton de validation #}
    <div class="d-flex justify-content-end align-items-center mt-4 pt-3 border-top">
        <button class="btn text-white fw-bold px-4 py-2 shadow-sm d-inline-flex align-items-center" style="background-color: #0F172A; border-left: 4px solid #D4AF37; border-radius: 8px;" type="submit">
            <i class="fas fa-save me-2" style="color: #D4AF37;"></i>
            <span>{{ button_label|default('Save') }}</span>
        </button>
    </div>

{{ form_end(form) }}
