{% extends 'base.html.twig' %}

{% block title %}Depense{% endblock %}

{% block body %}
<div class="min-vh-100 py-4 px-3 px-md-5" style="background-color: #F8FAFC;">
    <div class="container-fluid max-w-4xl mx-auto">

        {# Barre d'en-tête et navigation #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <a href="{{ path('app_depense_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2">
                    <i class="fas fa-arrow-left me-2"></i>back to list
                </a>
                <h2 class="fw-bold mb-0" style="color: #0F172A;">
                    <i class="fas fa-file-invoice-dollar me-2" style="color: #D4AF37;"></i>Depense #{{ depense.id }}
                </h2>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_depense_edit', {'id': depense.id}) }}" class="btn fw-bold px-3 py-2 text-white" style="background-color: #0F172A; border-radius: 8px;">
                    <i class="fas fa-edit me-1 text-warning"></i> edit
                </a>
                {{ include('depense/_delete_form.html.twig') }}
            </div>
        </div>

        {# Carte de détail principale #}
        <div class="card shadow border-0 overflow-hidden" style="border-radius: 16px; background-color: #FFFFFF;">
            
            {# En-tête de carte Midnight Blue & Gold #}
            <div class="card-header text-white p-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border-bottom: 4px solid #D4AF37;">
                <div>
                    <span class="badge bg-white bg-opacity-10 text-uppercase fs-7 mb-1" style="color: #D4AF37;">Fiche Dépense</span>
                    <h4 class="fw-bold mb-0 text-white">Détails de l'Enregistrement</h4>
                </div>
                <div class="rounded-circle p-3 text-center" style="background-color: rgba(212, 175, 55, 0.15); color: #D4AF37;">
                    <i class="fas fa-receipt fa-lg"></i>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <tbody>
                            <tr style="border-bottom: 1px solid #E2E8F0;">
                                <th class="ps-4 py-3 text-uppercase font-monospace text-muted" style="width: 30%; font-size: 0.85rem;">
                                    <i class="fas fa-hashtag me-2" style="color: #D4AF37;"></i>Id
                                </th>
                                <td class="py-3 font-monospace fw-bold text-dark">
                                    #{{ depense.id }}
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #E2E8F0;">
                                <th class="ps-4 py-3 text-uppercase font-monospace text-muted" style="font-size: 0.85rem;">
                                    <i class="fas fa-align-left me-2" style="color: #D4AF37;"></i>Description
                                </th>
                                <td class="py-3 text-dark">
                                    {{ depense.description ? depense.description : '-' }}
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #E2E8F0;">
                                <th class="ps-4 py-3 text-uppercase font-monospace text-muted" style="font-size: 0.85rem;">
                                    <i class="fas fa-money-bill-wave me-2" style="color: #D4AF37;"></i>Montant
                                </th>
                                <td class="py-3 font-monospace fw-bold fs-5 text-danger">
                                    {{ depense.montant ? depense.montant|number_format(0, ',', ' ') ~ ' FCFA' : '-' }}
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #E2E8F0;">
                                <th class="ps-4 py-3 text-uppercase font-monospace text-muted" style="font-size: 0.85rem;">
                                    <i class="fas fa-tags me-2" style="color: #D4AF37;"></i>Typedepense
                                </th>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-3 py-2 text-uppercase font-monospace" style="letter-spacing: 0.5px;">
                                        {{ depense.typedepense ?? 'N/A' }}
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 text-uppercase font-monospace text-muted" style="font-size: 0.85rem;">
                                    <i class="far fa-calendar-alt me-2" style="color: #D4AF37;"></i>CreatetAt
                                </th>
                                <td class="py-3 text-secondary">
                                    {{ depense.createtAt ? depense.createtAt|date('d/m/Y') : '-' }}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {# Pied de carte avec actions rapides #}
            <div class="card-footer bg-light py-3 px-4 d-flex justify-content-between align-items-center border-top">
                <a href="{{ path('app_depense_index') }}" class="btn btn-sm btn-outline-dark">
                    <i class="fas fa-list me-1"></i> back to list
                </a>
                <a href="{{ path('app_depense_edit', {'id': depense.id}) }}" class="btn btn-sm btn-warning text-dark font-weight-bold">
                    <i class="fas fa-edit me-1"></i> edit
                </a>
            </div>

        </div>

    </div>
</div>
{% endblock %}