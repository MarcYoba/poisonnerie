<form method="post" action="{{ path('app_depense_delete', {'id': depense.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="d-inline-block">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
    <button class="btn btn-outline-danger btn-sm px-3 shadow-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px; transition: all 0.2s ease;">
        <i class="fas fa-trash-alt me-1"></i>
        <span>Delete</span>
    </button>
</form>
