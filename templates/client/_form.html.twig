{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form) }}
    <div class="row g-3 mb-4">
        {# Nom / Raison Sociale #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.nom, 'Nom / Raison Sociale', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fas fa-user-tier" style="color: #0F172A;"></i>
                    </span>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control border-start-0', 'placeholder': 'ex: Cabinet Vétérinaire Katanga ou Jean Dupont'}}) }}
                </div>
                {{ form_errors(form.nom) }}
            </div>
        </div>

        {# Catégorie / Type de Client #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.typeClient, "Type / Catégorie d'Acheteur", {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fas fa-id-card" style="color: #D4AF37;"></i>
                    </span>
                    {{ form_widget(form.typeClient, {'attr': {'class': 'form-select border-start-0'}}) }}
                </div>
                {{ form_errors(form.typeClient) }}
            </div>
        </div>

        {# Téléphone #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.telephone, 'Téléphone', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fas fa-phone-alt" style="color: #0F172A;"></i>
                    </span>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control border-start-0', 'placeholder': 'ex: +237 6XX XX XX XX'}}) }}
                </div>
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        {# Email #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.email, 'Adresse Email', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fas fa-envelope" style="color: #D4AF37;"></i>
                    </span>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control border-start-0', 'placeholder': 'ex: contact@entreprise.cm'}}) }}
                </div>
                {{ form_errors(form.email) }}
            </div>
        </div>
    </div>

    {# Rendu automatique des champs masqués (Token CSRF, etc.) #}
    {{ form_rest(form) }}

    {# Barre d'actions en bas de carte #}
    <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
        <a href="{{ path('app_client_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
            <i class="fas fa-times me-1"></i>Annuler
        </a>
        <button type="submit" class="btn btn-sm text-white fw-bold px-4 d-inline-flex align-items-center shadow-sm" style="background-color: #0F172A; border-bottom: 2px solid #D4AF37;">
            <i class="fas fa-save me-1" style="color: #D4AF37;"></i>{{ button_label|default('Enregistrer le Client') }}
        </button>
    </div>
{{ form_end(form) }}