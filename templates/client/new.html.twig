{% extends 'base.html.twig' %}

{% block title %}Nouveau Client{% endblock %}

{% block body %}
{% include "navbar.html.twig" %}

<div class="container py-4">
    {# Fil d'Ariane #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_client_index') }}" class="text-decoration-none fw-bold" style="color: #0F172A;">
                    <i class="fas fa-users me-1" style="color: #D4AF37;"></i>Gestion Clients
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Nouveau Client</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                
                {# En-tête de Carte #}
                <div class="card-header py-3 border-0 d-flex justify-content-between align-items-center" style="background-color: #0F172A; border-bottom: 3px solid #D4AF37 !important;">
                    <div>
                        <span class="badge mb-1 text-uppercase" style="background-color: #D4AF37; color: #0F172A;">Création</span>
                        <h1 class="h5 mb-0 fw-bold text-white d-flex align-items-center">
                            <i class="fas fa-user-plus me-2" style="color: #D4AF37;"></i>Ajouter un Nouveau Client
                        </h1>
                        <p class="text-white-50 small mb-0 mt-1">
                            Renseignez les coordonnées et informations relatives à votre nouvel acheteur.
                        </p>
                    </div>
                    <a href="{{ path('app_client_index') }}" class="btn btn-sm btn-outline-light border-0 text-white fw-bold">
                        <i class="fas fa-arrow-left me-1" style="color: #D4AF37;"></i>Retour Liste Clients
                    </a>
                </div>

                {# Corps de la Carte #}
                <div class="card-body p-4 bg-white">
                    <div class="alert alert-light border-start border-4 mb-4" style="border-color: #D4AF37 !important; background-color: #F8FAFC;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle fa-lg me-3" style="color: #0F172A;"></i>
                            <small class="text-muted">
                                Les champs obligatoires doivent être soigneusement remplis pour permettre la facturation et le suivi.
                            </small>
                        </div>
                    </div>

                    {{ include('client/_form.html.twig', {'button_label': 'Créer le Client'}) }}
                </div>

                {# Pied de Carte #}
                <div class="card-footer bg-light p-3 border-0 text-muted small text-center">
                    <i class="fas fa-shield-alt me-1 text-primary"></i> Les données saisies seront enregistrées dans votre registre client.
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}