{# Bouton Déclencheur de la Modale #}
<button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#deleteClientModal{{ client.id }}" title="Supprimer le client">
    <i class="fas fa-trash-alt me-1"></i>Supprimer
</button>

{# Fenêtre Modale de Confirmation #}
<div class="modal fade" id="deleteClientModal{{ client.id }}" tabindex="-1" aria-labelledby="deleteClientModalLabel{{ client.id }}" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            
            {# En-tête de la Modale #}
            <div class="modal-header text-white" style="background-color: #0F172A; border-bottom: 3px solid #D4AF37;">
                <h5 class="modal-title h6 fw-bold mb-0 d-flex align-items-center" id="deleteClientModalLabel{{ client.id }}">
                    <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Confirmation de Suppression
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            {# Corps de la Modale #}
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 p-3 mb-2" style="width: 60px; height: 60px;">
                        <i class="fas fa-user-slash fa-2x text-danger"></i>
                    </div>
                </div>
                
                <h6 class="fw-bold text-dark mb-2">Êtes-vous sûr de vouloir supprimer ce client ?</h6>
                <p class="text-muted small mb-0">
                    Vous êtes sur le point de retirer définitivement <strong>{{ client.nom }}</strong> du registre client.
                </p>
            </div>

            {# Pied de la Modale avec Formulaire de Suppression #}
            <div class="modal-footer bg-light border-0 d-flex justify-content-center gap-2 py-3">
                <button type="button" class="btn btn-sm btn-light border px-3" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Annuler
                </button>

                <form method="post" action="{{ path('app_client_delete', {'id': client.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                    <button type="submit" class="btn btn-sm btn-danger fw-bold px-4">
                        <i class="fas fa-check me-1"></i>Oui, Supprimer
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>