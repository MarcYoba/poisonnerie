{% extends 'base.html.twig' %}

{% block title %}Modifier l'employé{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0">
                {# En-tête de la carte #}
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 font-weight-bold">
                        <i class="fas fa-user-edit me-2"></i>Modifier l'employé : {{ employee.nom }}
                    </h5>
                    <a href="{{ path('app_employee_list') }}" class="btn btn-sm btn-outline-light">
                        <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                    </a>
                </div>

                {# Corps du formulaire #}
                <div class="card-body p-4">
                    {{ include('employee/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>

                {# Pied de carte avec zone de suppression #}
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-eye me-1"></i> Consulter la fiche
                    </a>

                    <div>
                        {{ include('employee/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}