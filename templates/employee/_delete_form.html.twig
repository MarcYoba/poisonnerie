<form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet employé ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
    <button class="btn btn-outline-danger">
        <i class="fas fa-trash-alt me-1"></i> Supprimer
    </button>
</form>
